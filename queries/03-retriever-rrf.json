{
  "retriever": {
    "rrf": {
      "retrievers": [
        {
          "standard": {
            "query": {
              "multi_match": { "query": "{{query}}", "fields": ["title", "authors"] }
            }
          }
        },
        {
          "standard": {
            "query": { "match": { "description": "{{query}}" } }
          }
        }
      ],
      "rank_window_size": 50,
      "rank_constant": 20
    }
  },
  "_source": ["title", "authors", "description"],
  "size": 10
}
